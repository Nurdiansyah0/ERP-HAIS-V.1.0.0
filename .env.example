# ===========================================
# HAIS ERP - Environment Configuration Template
# ===========================================
# Copy this file to `.env` and fill in the real values.
# NEVER commit real secrets or passwords!

# ==================== BACKEND (Rust / hais-backend) ====================

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:your-strong-password@localhost:5432/hais_db?sslmode=disable

# Server Configuration
PORT=3000
HOST=0.0.0.0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-64-characters-long-change-this-immediately-in-production
JWT_EXPIRATION=60m
REFRESH_TOKEN_EXPIRATION=7d

# Redis (Session, Cache, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Email / Notification (SMTP - Gmail recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="HAIS ARFF System" <no-reply@hais.example.com>

# Optional: Gmail OAuth2 (better deliverability)
# GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=1//your-refresh-token

# Logging
RUST_LOG=info,sqlx=warn

# Security
RATE_LIMIT_PER_MINUTE=100

# ==================== FRONTEND (React Native / HAIS-App) ====================

EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1   # For Android Emulator
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1 # For iOS / Web
EXPO_PUBLIC_API_TIMEOUT=15000

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME="HAIS ERP"
EXPO_PUBLIC_APP_VERSION=1.0.0

# Optional: Push Notifications / Firebase
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=hais-erp

# Optional: Maps / Vehicle GPS
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ==================== DOCKER / DEVELOPMENT ====================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password
POSTGRES_DB=hais_db

# Redis
REDIS_PORT=6379

# Optional: Object Storage (MinIO / S3 for inspection photos)
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=password
# MINIO_ENDPOINT=http://localhost:9000

# ===========================================
# USAGE:
# 1. cp .env.example .env
# 2. Fill in real values
# 3. Add `.env` to .gitignore (already done)
# 4. For production: use secrets manager (GitHub Secrets, Docker Secrets, etc.)
# ===========================================