# ===========================================
# HAIS ERP - Environment Configuration
# Hang Nadim ARFF Integrated System
# ===========================================
# 
# INSTRUCTIONS:
# 1. cp .env.example .env
# 2. Fill in your actual values (never commit real secrets!)
# 3. For production, use environment variables or secrets manager (e.g. GitHub Secrets, Docker Secrets, AWS Secrets Manager)
# 4. .env is already in .gitignore

# ===========================================
# BACKEND (Rust + Axum + PostgreSQL + Redis)
# ===========================================

# --- Database ---
DATABASE_URL=postgres://postgres:your_strong_password_here@localhost:5432/hais_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Authentication & JWT ---
# Use strong, unique secrets in production (min 64 chars recommended)
JWT_SECRET=your-super-long-secret-key-change-this-in-production-immediately
JWT_ISSUER=HAIS-ERP
JWT_AUDIENCE=hais-app
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# --- OTP (One-Time Password) for login/recovery ---
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=3

# --- Redis (Cache, Sessions, Rate Limiting, OTP storage) ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=   # leave empty if no password

# --- CORS (Cross-Origin Resource Sharing) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://10.0.2.2:8081,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# --- Email / Notifications ---
# Option 1: SMTP (Gmail App Password recommended for simplicity)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hais-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="HAIS ARFF System" <no-reply@hais.example.com>

# Option 2: Gmail OAuth2 (more secure & better deliverability - recommended for production)
# To set up:
# 1. Go to Google Cloud Console > APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID (Desktop app or Web app)
# 3. Enable Gmail API
# 4. Get refresh token using oauth2l or similar tool
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=1//0your-long-refresh-token-here
GMAIL_USER=your-hais-email@gmail.com   # The Gmail account to send from

# --- Logging & Debugging ---
RUST_LOG=info,axum=debug,sqlx=warn,tower_http=debug
RUST_BACKTRACE=1

# --- Security ---
ARGON2_MEMORY_COST=65536   # For password hashing (Argon2id)
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- File Uploads (Inspection photos, documents) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# ===========================================
# FRONTEND (React Native + Expo)
# ===========================================

# API Connection
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1   # Android Emulator
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1         # iOS Simulator / Web
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# App Info
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME="HAIS ERP - ARFF"
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_COMPANY_NAME="Hang Nadim International Airport"

# Optional: Push Notifications (Expo / Firebase)
# EXPO_PUBLIC_EXPO_PUSH_TOKEN=ExponentPushToken[...]
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=hais-erp-arff
# EXPO_PUBLIC_FIREBASE_APP_ID=1:...

# Optional: Google Maps / Location (for vehicle tracking)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourKeyHere

# ===========================================
# DOCKER & LOCAL DEVELOPMENT
# ===========================================

# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=hais_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Optional: MinIO / S3-compatible for file storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your-minio-password
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=hais-uploads

# ===========================================
# NOTES
# - All EXPO_PUBLIC_* vars are exposed to the mobile app (client-side)
# - Backend-only vars should NEVER be exposed to frontend
# - For production deployment, remove sensitive defaults and use proper secret management
# - Test email sending with the chosen provider before going live
# ===========================================